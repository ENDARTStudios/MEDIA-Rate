{
    "extends":  "../../tooling/typescript/tsconfig.base.json",
    "compilerOptions":  {
                            "outDir":  "./dist",
                            "rootDir":  "../../",
                            "types":  [
                                          "node",
                                          "jest"
                                      ],
                            "experimentalDecorators":  true,
                            "emitDecoratorMetadata":  true,
                            "useDefineForClassFields":  false,
                            "target":  "ES2021",
                            "module":  "commonjs",
                            "strict":  true,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "paths":  {
      "@mediarate/core-domain": ["../../packages/core-domain/src/index.ts"],
                                          "@mediarate/core-ports":  [
                                                                        "../../packages/core-ports/src/index.ts"
                                                                    ],
                                          "@mediarate/core-events":  [
                                                                         "../../packages/core-events/src/index.ts"
                                                                     ],
                                          "@mediarate/core-result":  [
                                                                         "../../packages/core-result/src/index.ts"
                                                                     ],
                                          "@mediarate/core-errors":  [
                                                                         "../../packages/core-errors/src/index.ts"
                                                                     ],
                                          "@mediarate/core-config":  [
                                                                         "../../packages/core-config/src/index.ts"
                                                                     ]
                                      }
                        },
    "include":  [
                    "src"
                ]
}

