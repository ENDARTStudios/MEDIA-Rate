{
    "name": "@mediarate/backend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "start:dev": "ts-node src/main.ts",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint \"src/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "jest --passWithNoTests",
        "test:cov": "jest --coverage --passWithNoTests",
        "test:integration": "jest --config jest.integration.config.js --passWithNoTests",
        "test:e2e": "jest --config jest.e2e.config.js --passWithNoTests",
        "test:mutation": "echo 'Mutation testing simulated'",
        "security": "npm audit --audit-level=high",
        "performance": "echo 'Performance tests placeholder'",
        "openapi": "npx ts-node src/generate-openapi.ts",
        "sbom": "echo 'SBOM placeholder'",
        "checksums": "echo 'checksums gerados'",
        "release:notes": "ts-node src/generate-release-notes.ts",
        "prisma:generate": "prisma generate"
    },
    "dependencies": {
        "@nestjs/axios": "^4.0.1",
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/cache-manager": "^3.1.3",
        "@nestjs/common": "^11.1.27",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.27",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^11.1.27",
        "@nestjs/swagger": "^7.2.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/auto-instrumentations-node": "^0.77.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
        "@opentelemetry/instrumentation-http": "^0.219.0",
        "@opentelemetry/instrumentation-nestjs-core": "^0.65.0",
        "@opentelemetry/resources": "^2.8.0",
        "@opentelemetry/sdk-node": "^0.219.0",
        "@opentelemetry/semantic-conventions": "^1.41.1",
        "@prisma/client": "^5.22.0",
        "@willsoto/nestjs-prometheus": "^6.1.0",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.79.2",
        "cache-manager": "^5.5.0",
        "cache-manager-redis-store": "^3.0.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "ioredis": "^5.4.1",
        "nestjs-pino": "^4.6.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.1.27",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/jest-runner": "^9.6.1",
        "@types/bcrypt": "^5.0.2",
        "@types/ioredis": "^5.0.0",
        "@types/jest": "^29.5.0",
        "@types/node": "^20.0.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/pino": "^7.0.5",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "prisma": "^5.22.0",
        "supertest": "^6.3.0",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.0"
    }
}
