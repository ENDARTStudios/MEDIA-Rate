# ============================================================
# MEDIA Rate — Web (apps/web) — variáveis de ambiente (FRONTEND)
# Copie para .env.local (Next.js carrega automaticamente) e preencha.
# SOMENTE variáveis públicas (NEXT_PUBLIC_*). Nenhum segredo de backend
# deve ficar aqui — eles pertencem ao apps/api/.env (ver apps/api/.env.example).
#
# IMPORTANTE (T377): variáveis NEXT_PUBLIC_* são inlineadas no BUILD do Next.js.
# Alterar o valor na Vercel NÃO afeta o site até um novo deploy (redeploy
# Production). Sempre dispare um redeploy após mudar qualquer NEXT_PUBLIC_*.
# ============================================================

# URL base da API (ex.: https://api.media-rate.up.railway.app)
NEXT_PUBLIC_API_URL=

# URL pública do site (canônica/SEO, ex.: https://media-rate.up.railway.app)
NEXT_PUBLIC_SITE_URL=

# Chave pública do PostHog (analytics) — https://app.posthog.com/project/settings
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

# Host do PostHog (default https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# T361 — Login Google (Google Identity Services). ID do client OAuth (público).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ============================================================
# VARIÁVEIS DE SERVIDOR (NÃO públicas) — para rodar o web localmente
#
# O comentário do topo dizia "SOMENTE NEXT_PUBLIC_*", mas o servidor do Next lê
# as variáveis abaixo — e a ausência delas quebra o login local de um jeito que
# não aparece no navegador: a sessão é validada contra a API de PRODUÇÃO.
# (Achado 2026-10-15: descoberto lendo next.config.ts/lib/auth-server.ts
#  durante o destravamento do `test:auth` — ver D-605/D-606.)
# ============================================================

# Destino do rewrite `/api/*` E base usada na validação de sessão do servidor
# (next.config.ts + lib/auth-server.ts + lib/admin-auth-server.ts).
# Sem definir, o default é a API de PRODUÇÃO — o que faz uma sessão local
# parecer inválida e redireciona /admin e /dashboard para /login.
#   Local:  API_PROXY_TARGET=http://localhost:4000   (porta do apps/api/.env.example)
#   CI:     API_PROXY_TARGET=http://localhost:4000
API_PROXY_TARGET=

# Token do endpoint /api/revalidate (revalidação sob demanda do ISR).
# Precisa casar com o REVALIDATE_SECRET da API (ver .env.example da raiz).
REVALIDATE_SECRET=

# PostHog server-side (proxy de eventos no servidor). Opcional em dev:
# sem estas, o servidor simplesmente não envia eventos.
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# NODE_ENV, VERCEL_ENV e VERCEL_GIT_COMMIT_SHA NÃO se definem aqui: são
# injetadas pelo Next.js/Vercel e o código apenas as lê.
