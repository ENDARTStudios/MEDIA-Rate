# ============================================================
# MEDIA Rate — Web (apps/web) — variáveis de ambiente (FRONTEND)
# Copie para .env.local (Next.js carrega automaticamente) e preencha.
# SOMENTE variáveis públicas (NEXT_PUBLIC_*). Nenhum segredo de backend
# deve ficar aqui — eles pertencem ao apps/api/.env (ver apps/api/.env.example).
# ============================================================

# URL base da API (ex.: https://api.media-rate.up.railway.app)
NEXT_PUBLIC_API_URL=

# URL pública do site (canônica/SEO, ex.: https://media-rate.up.railway.app)
NEXT_PUBLIC_SITE_URL=

# Chave pública do PostHog (analytics) — https://app.posthog.com/project/settings
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

# Host do PostHog (default https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# T361 — Login Google (Google Identity Services). ID do client OAuth (público).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
