# ============================================================
# MEDIA Rate — API (apps/api) — variáveis de ambiente (BACKEND)
# Copie para .env (dentro de apps/api) e preencha.
# NUNCA commite o .env real. Nenhum segredo do backend deve ir para o
# frontend (apps/web/.env.example) nem para a raiz (.env.example — tooling).
# Obrigatórias em produção: DATABASE_URL, COOKIE_SECRET, ADMIN_TOKEN,
# TMDB_API_KEY, TWITCH_CLIENT_ID/SECRET, COMICVINE_API_KEY,
# COLUMN_ENCRYPTION_KEY, STRIPE_*.
# ============================================================

# --- Núcleo ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# PostgreSQL — obrigatória (Prisma).
DATABASE_URL=postgresql://usuario:senha@host:5432/media_rate?schema=public
# Assinatura do cookie de sessão — OBRIGATÓRIA em produção (main.ts lê
# COOKIE_SECRET; sem ela o boot falha). Gerar: openssl rand -hex 32
COOKIE_SECRET=
# Token de admin — OBRIGATÓRIO em produção (rotas admin / re-coleta).
# Gerar: openssl rand -hex 32
ADMIN_TOKEN=

# --- CORS / segurança ---
# Origens permitidas (CORS). ALLOWED_ORIGINS = lista separada por vírgula;
# CORS_ORIGIN = alternativa de uma origem única (cors.config lê ambas).
CORS_ORIGIN=
ALLOWED_ORIGINS=
# Origens extras permitidas na CSP (script-src) — separadas por vírgula.
CSP_TRUSTED_ORIGINS=
# Criptografia de colunas sensíveis (LGPD). Gerar: openssl rand -base64 32
COLUMN_ENCRYPTION_KEY=
# Pepper do hash Argon2 (opcional, recomendado em produção).
ARGON2_SECRET_PEPPER=
# TTL da sessão em horas (default 168 = 7 dias).
SESSION_TTL_HOURS=168
# Nível de log (debug|info|warn|error).
LOG_LEVEL=info

# --- Rate limit (rate-limit.config) ---
RATE_LIMIT_API_PER_MIN=100
RATE_LIMIT_LOGIN_PER_MIN=6

# --- Cache / filas (Redis) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Stripe (pagamento) — obrigatórias para checkout ---
# Painel Stripe: https://dashboard.stripe.com/apikeys e /products
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_ID=
STRIPE_PRICE_PREMIUM_ID=
STRIPE_PAYMENT_METHODS=card

# --- Fontes de nota (especificação "Fontes de Dados") ---
# TMDB (catálogo filmes/séries + seeds) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb (IMDb ratings) — https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Trakt.tv — https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=
# OpenCritic (RapidAPI) — https://rapidapi.com/opencritic-opencritic-default/api/opencritic-api
OPENCRITIC_API_KEY=
# Comic Vine (HQs) — https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=
# Google Books — https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
# SteamSpy (opcional; adapter inativo sem chave).
STEAMSPY_API_KEY=
# IGDB autentica via OAuth da Twitch (igdb.adapter lê as duas abaixo).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Scraping NUMÉRICO isolado (nota apenas; Feist 499 U.S. 340 / art. 7º Lei
# 9.610/98). Aplica a Letterboxd, Rotten Tomatoes, Metacritic e RogerEbert.
# Política: ativar somente quando não houver API gratuita para a fonte.
SCRAPE_NUMERICO_ENABLED=false
# Fase de PREPARAÇÃO (P2) — livros/HQs/mangás. Sem ativação de produção
# até as fontes serem validadas.
MEDIA_PREPARACAO_ENABLED=false
# IMDb Datasets (title.ratings.tsv) — caminho local do dataset baixado.
IMDB_DATASET_PATH=

# --- Job de score (media-score-job.service) ---
MEDIA_SCORE_JOB_ENABLED=true
MEDIA_SCORE_JOB_TIME=03:05
MEDIA_SCORE_JOB_DELAY_MS=1200

# --- Debug / observabilidade ---
# Rotas _force-error e _debug/coletar (APENAS desenvolvimento).
ENABLE_DEBUG_ROUTES=false
# Swagger em /api/docs (apenas com SWAGGER_ENABLED=true).
SWAGGER_ENABLED=false
# Pula conexão com o banco (testes/CI) — não usar em produção.
SKIP_DB_CONNECT=false
# PostHog (analytics) — opcional.
ANALYTICS_WRITE_KEY=
POSTHOG_HOST=https://app.posthog.com
