# ============================================================
# MEDIA Rate — API (apps/api) — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.
# Obrigatórias em produção: DATABASE_URL, COOKIE_SECRET.
# ============================================================

# --- Núcleo ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# PostgreSQL. Obrigatória (main.ts + Prisma). Formato:
# postgresql://usuario:senha@host:5432/media_rate?schema=public
DATABASE_URL=postgresql://usuario:senha@localhost:5432/media_rate?schema=public
# Assinatura do cookie de sessão — OBRIGATÓRIA em produção. O código lê
# COOKIE_SECRET (apps/api/src/main.ts); sem ela o boot falha em produção.
# Gerar: openssl rand -hex 32
COOKIE_SECRET=
# JWT_SECRET — NÃO é lida pelo código atualmente (a sessão usa COOKIE_SECRET).
# Mantida por compatibilidade com a configuração do Railway. Opcional.
JWT_SECRET=
# Token de admin — rotas administrativas exigem em produção (admin-token.util).
# Gerar: openssl rand -hex 32
ADMIN_TOKEN=

# --- Cache / filas (Redis) ---
# Forma preferida (cache.service e cache.module): URL completa.
# REDIS_HOST/PORT/PASSWORD são alternativa de configuração (app.module).
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- CORS / segurança ---
# Origem(s) permitida(s) para o navegador. CORS_ORIGIN (usada no Railway) ou
# ALLOWED_ORIGINS (lista separada por vírgula) — cors.config lê ambas.
CORS_ORIGIN=
ALLOWED_ORIGINS=
# Origens extras permitidas na CSP (script-src) — separadas por vírgula.
CSP_TRUSTED_ORIGINS=
# Criptografia de colunas sensíveis (32 bytes, base64) — opcional.
COLUMN_ENCRYPTION_KEY=
# Parâmetros Argon2 do hash de senha (opcionais; valores = defaults do código).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Pepper adicional do hash de senha (opcional, recomendado em produção).
ARGON2_SECRET_PEPPER=
# TTL da sessão em horas (default 168 = 7 dias) — session.service.
SESSION_TTL_HOURS=168

# --- Stripe (assinaturas) — obrigatórias para checkout/pagamento ---
# Secret key da conta Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret (endpoint /api/v1/payment/webhook) — dashboard do Stripe
STRIPE_WEBHOOK_SECRET=
# Price IDs dos planos (dashboard do Stripe) — usados no checkout.
STRIPE_PRICE_PLUS_ID=
STRIPE_PRICE_PREMIUM_ID=
# Métodos de pagamento aceitos (separados por vírgula; default "card").
STRIPE_PAYMENT_METHODS=card

# --- Fontes de nota (especificação "Fontes de Dados") ---
# TMDB — catálogo de filmes/séries e seeds (seed-tmdb.ts). Obrigatória para
# popular o catálogo. https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb (IMDb ratings) — https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Trakt.tv — https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=
# OpenCritic (via RapidAPI, tier free) —
# https://rapidapi.com/opencritic-opencritic-default/api/opencritic-api
OPENCRITIC_API_KEY=
# Comic Vine — https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=
# Google Books — https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
# SteamSpy (dados de jogadores Steam) — opcional; adapter inativo sem chave.
STEAMSPY_API_KEY=
# IGDB autentica via OAuth da Twitch (igdb.adapter lê as duas abaixo).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# IGDB_CLIENT_ID/SECRET — NÃO são lidas pelo código (o IGDB usa as credenciais
# Twitch acima). Mantidas por compatibilidade com a config do Railway. Opcionais.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Scraping NUMÉRICO isolado (nota apenas; Feist 499 U.S. 340 / art. 7º Lei
# 9.610/98). Aplica a Letterboxd, Rotten Tomatoes, Metacritic e RogerEbert.
# Política: ativar somente quando não houver API gratuita para a fonte.
SCRAPE_NUMERICO_ENABLED=false

# Fase de PREPARAÇÃO (P2) — livros/HQs/mangás (Goodreads, Skoob, LibraryThing,
# Amazon, ComicBookRoundup, Anime-Planet, Open Library). Sem ativação de
# produção até as fontes serem validadas.
MEDIA_PREPARACAO_ENABLED=false

# IMDb Datasets (title.ratings.tsv) — caminho local do dataset baixado.
# Quando ausente, o adapter fica inativo.
IMDB_DATASET_PATH=

# --- Job de score (media-score-job.service) ---
# Re-coleta periódica dos scores. Desligue com "false" se quiser coleta manual.
MEDIA_SCORE_JOB_ENABLED=true
# Horário UTC da execução diária (default 03:05).
MEDIA_SCORE_JOB_TIME=03:05
# Atraso entre requisições da coleta (ms; respeita rate limits das fontes).
MEDIA_SCORE_JOB_DELAY_MS=1200

# --- Logs / debug / observabilidade ---
# Nível de log (debug|info|warn|error) — default info em produção.
LOG_LEVEL=info
# Rotas _force-error e _debug/coletar (APENAS desenvolvimento; ignoradas com
# NODE_ENV=production).
ENABLE_DEBUG_ROUTES=false
# Swagger em /api/docs (habilitar apenas com SWAGGER_ENABLED=true).
SWAGGER_ENABLED=false
# Pula conexão com o banco (testes/CI) — não usar em produção.
SKIP_DB_CONNECT=false
# PostHog (analytics) — opcional.
ANALYTICS_WRITE_KEY=
POSTHOG_HOST=https://app.posthog.com
