// MEDIA Rate — schema Prisma (Fase 2)
// PostgreSQL + Prisma 6 (DECIDE-01).
// Convenção: nomes de modelos em português (Usuario, Sessao, Papel) para
// alinhar com o PLANO_MESTRE.md. Nomes de campos em snake_case para
// consistência com SQL.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

/// Faixa etária brasileira (DJCTQ). Conforme DISCOVERY-02 e T2.7.
enum ClassificacaoIndicativa {
  L // Livre para todos os públicos
  DEZ // 10 anos
  DOZE // 12 anos
  CATORZE // 14 anos
  DEZESSEIS // 16 anos
  DEZOITO // 18 anos
}

/// Tipos de mídia suportados pelo MEDIA Rate.
enum TipoMidia {
  FILME
  SERIE
  GAME
  LIVRO
  /// D-233: ANIME ficou deprecated no banco (animação japonesa = SERIE;
  /// quadrinho japonês = MANGA). Valor mantido para não quebrar enums
  /// existentes; nunca é exposto em API/filtros/frontend.
  ANIME
  MANGA
  COMIC
}

/// Planos de assinatura SaaS. Conforme DISCOVERY-02 Q4 e T2.9.
enum Plano {
  FREE
  PLUS
  PREMIUM
}

/// Status da assinatura do usuário (sincronizado com Stripe webhook).
enum StatusAssinatura {
  ATIVA
  CANCELADA
  PAST_DUE
  TRIALING
  PAUSADA
}

/// Tipos de evento de pagamento processados via webhook Stripe (T2.10).
enum TipoEventoPagamento {
  CHECKOUT_SESSION_COMPLETED
  CUSTOMER_SUBSCRIPTION_CREATED
  CUSTOMER_SUBSCRIPTION_UPDATED
  CUSTOMER_SUBSCRIPTION_DELETED
  INVOICE_PAYMENT_SUCCEEDED
  INVOICE_PAYMENT_FAILED
  CUSTOMER_SUBSCRIPTION_TRIAL_WILL_END
}

/// Papéis RBAC (T2.4). ADMIN tem acesso total; USER é o padrão.
enum PapelNome {
  USER
  ADMIN
  MODERADOR
  CURATOR
}

/// Finalidades de consentimento LGPD (T2.11).
enum FinalidadeConsentimento {
  MARKETING
  RECOMENDACAO_PERSONALIZADA
  COMPARTILHAMENTO_DADOS
  COOKIES_ANALITICOS
}

// ===========================================================================
// Usuário e autenticação (T2.2, T2.3, T2.4, T2.11)
// ===========================================================================

/// T2.2 + T2.11: usuário do MEDIA Rate.
model Usuario {
  id                   String                 @id @default(uuid()) @db.Uuid
  email                String                 @unique
  // T2.5: hash argon2id, nunca plaintext. TEXT para acomodar formato
  // $argon2id$v=19$m=...$salt$hash sem limite arbitrário.
  password_hash        String                 @map("password_hash") @db.Text
  nome                 String?                @db.VarChar(255)
  // T2.11: soft delete agendado pelo endpoint LGPD T4.9.
  dados_para_exclusao_at DateTime?            @map("dados_para_exclusao_at")
  email_verificado_em  DateTime?              @map("email_verificado_em")
  // T306/D-295: timestamp de aceite dos Termos e Condições (v1.0). Write-once
  // no register; base de consentimento LGPD art. 7º I / RGPD art. 6(1)(a).
  termos_aceitos_em    DateTime?              @map("termos_aceitos_em")
  // T214: token de verificação de email — SHA-256 do token opaco (nunca
  // plaintext) + expiração 24h; uso único (anulado após verificar).
  email_verification_token_hash  String?      @map("email_verification_token_hash") @db.VarChar(64)
  email_verification_expira_em   DateTime?    @map("email_verification_expira_em")
  ultimo_login_em      DateTime?              @map("ultimo_login_em")
  // Fase 3 complemento: reset de senha
  password_reset_token   String?               @unique @map("password_reset_token") @db.VarChar(64)
  password_reset_expira  DateTime?              @map("password_reset_expira")
  created_at           DateTime               @default(now()) @map("created_at")
  updated_at           DateTime               @updatedAt @map("updated_at")

  // Relacionamentos
  sessoes              Sessao[]
  papeis               UsuarioPapel[]
  plano                UsuarioPlano?
  eventos_pagamento    EventoPagamento[]
  consentimentos       ConsentimentoUsuario[]
  interacoes           UsuarioMidiaInteracao[]
  watchlist            WatchlistEntry[]
  preferencias         PreferenciaUsuario?
  scores_vistos        MediaScoreView[]
  faturas              Fatura[]
  discovery_events     DiscoveryEvent[]
  notificacoes         Notificacao[]
  usos_diarios         UsoDiario[]
  listas               ListaColaborativa[]
  lista_itens          ListaItem[]

  @@map("usuario")
}

/// T2.3: sessão via token opaco (não JWT). Apenas hash armazenado.
model Sessao {
  id          String   @id @default(uuid()) @db.Uuid
  usuario_id  String   @map("usuario_id") @db.Uuid
  // SHA-256 do token opaco gerado com crypto.randomBytes(32).
  token_hash  String   @unique @map("token_hash") @db.VarChar(64)
  // T212: refresh token rotativo — hash do token ATUAL (nunca plaintext).
  refresh_token_hash         String?  @unique @map("refresh_token_hash") @db.VarChar(64)
  // T212: hash do refresh ANTERIOR — detecta reuse (token já rotacionado).
  refresh_token_hash_anterior String? @map("refresh_token_hash_anterior") @db.VarChar(64)
  // T212: expiração do refresh (30 dias) — acesso expira em expires_at (15min).
  refresh_expira_em          DateTime? @map("refresh_expira_em")
  // T212: família de rotações da mesma sessão (revoga tudo no reuse).
  refresh_family_id          String?  @map("refresh_family_id") @db.Uuid
  // User-Agent para identificação do dispositivo (não PII direto).
  user_agent  String?  @map("user_agent") @db.Text
  ip_criacao  String?  @map("ip_criacao") @db.Inet
  expires_at  DateTime @map("expires_at")
  revoked_at  DateTime? @map("revoked_at")
  created_at  DateTime @default(now()) @map("created_at")

  usuario     Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([expires_at])
  // T333: detecção de reuse do refresh (era seq scan a cada /auth/refresh).
  @@index([refresh_token_hash_anterior])
  @@map("sessao")
}

/// T2.4: RBAC. Papel é imutável (enum); usuario_papel é N:N.
model Papel {
  id      Int          @id @default(autoincrement())
  nome    PapelNome    @unique
  usuarios UsuarioPapel[]

  @@map("papel")
}

/// T2.4: N:N entre Usuario e Papel.
model UsuarioPapel {
  usuario_id String @map("usuario_id") @db.Uuid
  papel_id   Int    @map("papel_id")
  atribuido_em DateTime @default(now()) @map("atribuido_em")
  atribuido_por String? @map("atribuido_por") @db.Uuid

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  papel   Papel   @relation(fields: [papel_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, papel_id])
  @@map("usuario_papel")
}

// ===========================================================================
// Planos via entitlements (T2.9)
// ===========================================================================

/// T2.9: catálogo de entitlements (características de plano). PK é a chave
/// textual (ex: 'max_watchlist_items', 'recommendation_tier').
model Entitlement {
  chave       String @id @db.VarChar(64)
  descricao   String @db.Text
  tipo        String @db.VarChar(32) // 'number' | 'boolean' | 'string'
  valor_padrao String? @db.Text @map("valor_padrao")
  created_at  DateTime @default(now()) @map("created_at")

  planos      PlanoEntitlement[]

  @@map("entitlement")
}

/// T2.9: N:N entre Plano (enum) e Entitlement. Define quais entitlements
/// cada plano concede e com qual valor.
model PlanoEntitlement {
  plano           Plano
  entitlement_chave String @map("entitlement_chave") @db.VarChar(64)
  valor           String @db.Text // valor do entitlement para este plano
  created_at      DateTime @default(now()) @map("created_at")

  entitlement     Entitlement @relation(fields: [entitlement_chave], references: [chave], onDelete: Cascade)

  @@id([plano, entitlement_chave])
  @@map("plano_entitlement")
}

/// T2.9: assinatura do usuário. Uma por usuário (1:1).
model UsuarioPlano {
  usuario_id           String           @id @map("usuario_id") @db.Uuid
  plano                Plano            @default(FREE)
  status               StatusAssinatura @default(ATIVA)
  // Stripe subscription ID (null para FREE). Permite reativar após
  // cancelamento sem recriar checkout.
  stripe_subscription_id String?         @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripe_customer_id    String?          @map("stripe_customer_id") @db.VarChar(255)
  current_period_end    DateTime?        @map("current_period_end")
  cancela_em            DateTime?        @map("cancela_em")
  // D-132: trial de 7 dias do Plus (Stripe trial_period_days).
  trial_ends_at         DateTime?        @map("trial_ends_at")
  trial_notified_at     DateTime?        @map("trial_notified_at")
  // T327: data da primeira ativação de trial — garante trial único por usuário.
  trial_used_at         DateTime?        @map("trial_used_at")
  created_at            DateTime         @default(now()) @map("created_at")
  updated_at            DateTime         @updatedAt @map("updated_at")

  usuario               Usuario          @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("usuario_plano")
}

// ===========================================================================
// Pagamento (T2.10)
// ===========================================================================

/// T2.10: auditoria de eventos de pagamento Stripe. stripe_event_id UNIQUE
/// garante idempotência — webhook reenviado não reprocessa.
model EventoPagamento {
  id              String              @id @default(uuid()) @db.Uuid
  usuario_id      String?             @map("usuario_id") @db.Uuid
  stripe_event_id String              @unique @map("stripe_event_id") @db.VarChar(255)
  tipo            TipoEventoPagamento
  // SHA-256 do payload para detecção de tampering.
  payload_hash    String              @map("payload_hash") @db.VarChar(64)
  // Payload completo em JSON (para auditoria/replay).
  payload_raw     Json                @map("payload_raw")
  processado_em   DateTime            @default(now()) @map("processado_em")
  // Resultado do processamento (sucesso/erro/ignorado).
  resultado       String              @db.VarChar(32)
  erro_mensagem   String?             @map("erro_mensagem") @db.Text

  usuario         Usuario?            @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([usuario_id])
  @@index([tipo])
  @@index([processado_em])
  @@map("evento_pagamento")
}

// ===========================================================================
// LGPD (T2.11)
// ===========================================================================

/// T2.11: consentimento do titular por finalidade. Uma linha por
/// finalidade ativa; revogação adiciona revogado_em.
model ConsentimentoUsuario {
  id            Int                 @id @default(autoincrement())
  usuario_id    String              @map("usuario_id") @db.Uuid
  finalidade    FinalidadeConsentimento
  consentido_em DateTime            @default(now()) @map("consentido_em")
  revogado_em   DateTime?           @map("revogado_em")
  // Texto do consentimento no momento do aceite (para auditoria legal).
  texto_versao  String              @map("texto_versao") @db.VarChar(32)
  ip_aceite     String?             @map("ip_aceite") @db.Inet

  usuario       Usuario             @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, finalidade])
  @@index([usuario_id])
  @@map("consentimento_usuario")
}

// ===========================================================================
// Domínio de mídia (T2.7 + extensão justificada pela ordem FASE-2)
// ===========================================================================

/// Catálogo de mídia. Sincronizado das fontes públicas (OMDb, TMDB, IGDB,
/// Open Library) — não é input do usuário.
model Midia {
  id                      String                 @id @default(uuid()) @db.Uuid
  // ID externo na fonte (ex: 'tt0111161' para IMDb, '12345' para TMDB).
  fonte_id                String                 @map("fonte_id") @db.VarChar(64)
  fonte                   String                 @db.VarChar(32) // 'omdb', 'tmdb', 'igdb', 'opencritic', 'openlibrary'
  // Score desnormalizado (último media_score) — permite ordenação escalar
  // por score sem orderBy de relação (quirk do engine Prisma em runtime).
  score                   Float?                 @map("score")
  // País de origem (ISO 3166-1 alfa-2, ex.: 'US', 'JP') — Addendum 2 §5.
  pais_origem             String?                @map("pais_origem") @db.VarChar(2)
  tipo                    TipoMidia
  titulo                  String                 @db.Text
  // T330: slug canônico (slugify(titulo)) indexado — elimina full scan no
  // getBySlug. NÃO é @unique (colisões de título desambiguam por tipo via
  // parseSlugDiscriminado "{slug}-{tipo}").
  slug                    String?                @map("slug") @db.VarChar(300)
  titulo_original         String?                @map("titulo_original") @db.Text
  sinopse                 String?                @db.Text
  ano_lancamento          Int?                   @map("ano_lancamento")
  // T2.7: enum brasileiro.
  classificacao_indicativa ClassificacaoIndicativa? @map("classificacao_indicativa")
  // T287 (Addendum 2): origem editorial da obra (mídia original da qual
  // deriva, ex.: filme adaptado de livro → LIVRO). ORIGINAL = obra própria.
  origem_editorial     OrigemEditorial?  @map("origem_editorial")
  // T289 (Arquitetura §4): multi-tenancy leve — default constante, sem
  // filtro nas queries ainda (RLS na T290, gated). Nunca exposto na API.
  tenant_id            String            @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  // URL de pôster/capa.
  imagem_url              String?                @map("imagem_url") @db.Text
  duracao_minutos         Int?                   @map("duracao_minutos")
  // T215 (2.9): soft delete — NULL = ativa; data = deletada (preservada).
  deleted_at              DateTime?              @map("deleted_at")
  created_at              DateTime               @default(now()) @map("created_at")
  updated_at              DateTime               @updatedAt @map("updated_at")

  scores                  MediaScore[]
  interacoes              UsuarioMidiaInteracao[]
  score_views             MediaScoreView[]
  generos                 MidiaGenero[]
  streamings              MidiaStreaming[]
  avaliacoes              AvaliacaoFonte[]
  franquias               MidiaFranquia[]
  relacoes_origem         RelacaoObra[] @relation("RelacaoObraOrigem")
  relacoes_destino        RelacaoObra[] @relation("RelacaoObraDestino")
  // T286 — eventos de descoberta gerados a partir de reações GOSTEI.
  discovery_from          DiscoveryEvent[] @relation("DiscoveryFrom")
  discovery_to            DiscoveryEvent[] @relation("DiscoveryTo")
  // T287 (Addendum 2) — contexto da obra: classificação por região + prêmios.
  classificacoes_regiao   ClassificacaoRegiao[]
  premios                 Premio[]
  // T288 — temporadas/episódios reais (TMDB) com notas.
  temporadas              Temporada[]
  // Última coleta de avaliações das fontes (null = nunca coletado).
  avaliacoes_atualizadas_em DateTime? @map("avaliacoes_atualizadas_em")

  @@unique([fonte, fonte_id])
  @@index([tipo])
  @@index([titulo])
  @@index([slug])
  @@index([score])
  @@map("midia")
}

/// MEDIA Score™ por mídia. Recalculado por job diário (T4.7) ou após coleta
/// (rota admin POST /api/v1/midias/:id/coletar).
model MediaScore {
  id           String   @id @default(uuid()) @db.Uuid
  midia_id     String   @map("midia_id") @db.Uuid
  // Score 0–100 (clipping do algoritmo z-score + pesos).
  score        Float
  // Quantidade de fontes que contribuíram para o cálculo.
  num_fontes   Int      @map("num_fontes")
  // Pesos usados no cálculo (JSON para auditoria/replay).
  pesos_usados Json     @map("pesos_usados")
  // v2 (CRIT-02): score do bucket Crítica (0–100), null sem fontes de crítica.
  score_critica Float?  @map("score_critica")
  // v2 (CRIT-02): score do bucket Público (0–100), null sem fontes de público.
  score_publico Float?  @map("score_publico")
  // v2: |crítica − público| em 0–100 (informativo, não realimenta o score).
  consenso      Float?  @map("consenso")
  // v3 (MET-03): índice de consenso 0–100 (I = 100 − |crítica − público|) —
  // REALIMENTA o score com peso por tipo.
  indice_consenso Float? @map("indice_consenso")
  // v3 (MET-03): votos totais coletados (Σ votos das fontes) — input do
  // pull Bayesiano e do fator Volume da confiança.
  votos_total   Int?    @map("votos_total")
  // Confidence Score 0–100 (v3: 40×cobertura + 30×volume + 20×concordância +
  // 10×atualização). Faixas: ≥70 Alta, ≥40 Média, <40 Baixa.
  confianca     Float?  @map("confianca")
  // v2: detalhes por fonte (JSON com fonte, classificação, z-score, peso).
  detalhes      Json?   @map("detalhes")
  calculado_em  DateTime @default(now()) @map("calculado_em")

  midia        Midia    @relation(fields: [midia_id], references: [id], onDelete: Cascade)

  @@unique([midia_id])
  @@index([score])
  @@map("media_score")
}

/// Avaliação bruta coletada de uma fonte externa para uma mídia.
/// Persistida para auditoria (url), re-coleta idempotente e recomputação
/// do MEDIA Score (T4.7 — substitui NotaColetada volátil).
model AvaliacaoFonte {
  id           String   @id @default(uuid()) @db.Uuid
  midia_id     String   @map("midia_id") @db.Uuid
  // Id canônico no source-registry (ex.: "tmdb", "metacritic", "igdb_publico").
  fonte        String   @db.VarChar(32)
  // Rating bruto na escala original da fonte (0–10, 0–100, 0–5, ratio 0–1…).
  rating       Float
  // Média estatística da fonte (mesma escala do rating).
  media_fonte  Float    @map("media_fonte")
  // Desvio-padrão estatístico da fonte (mesma escala do rating).
  desvio_fonte Float    @map("desvio_fonte")
  // v3 (MET-03): votos/reviews reportados pela fonte para a obra (TMDB
  // vote_count, Steam total de reviews, IGDB rating_count…). null = não
  // medido — pull Bayesiano e fator Volume da confiança usam 0.
  votos        Int?
  // URL pública da nota (transparência/auditoria).
  url          String?  @db.Text
  coletado_em  DateTime @default(now()) @map("coletado_em")

  midia        Midia    @relation(fields: [midia_id], references: [id], onDelete: Cascade)

  @@unique([midia_id, fonte])
  @@index([midia_id])
  @@map("avaliacao_fonte")
}

/// Interação do usuário com mídia (assistiu, avaliou, salvou, etc.).
/// Dado pessoal LGPD (T2.6 — criptografia de coluna aplicável).
model UsuarioMidiaInteracao {
  id          String   @id @default(uuid()) @db.Uuid
  usuario_id  String   @map("usuario_id") @db.Uuid
  midia_id    String   @map("midia_id") @db.Uuid
  // ADDENDUM 4 — Eixo 1: status de consumo (máquina de estados Parte 3).
  status      StatusConsumo @default(QUERO_CONSUMIR)
  // ADDENDUM 4 — Eixo 2: reação (opcional; só editável quando o status é
  // CONCLUIDO ou ABANDONADO — serviço rejeita em QUERO_CONSUMIR/CONSUMINDO).
  reacao      ReacaoConsumo?
  // Motivo do abandono (opcional, 3 chips — nunca obrigatório).
  motivo_abandono MotivoAbandono? @map("motivo_abandono")
  // Progresso mídia-específico ("T2E5", "pág. 230/400", "42%") — opcional.
  progresso_detalhe String? @map("progresso_detalhe") @db.VarChar(64)
  iniciado_em   DateTime? @map("iniciado_em")
  concluido_em  DateTime? @map("concluido_em")
  atualizado_em DateTime @default(now()) @updatedAt @map("atualizado_em")
  // T201 (G4) — origem da descoberta cross-mídia: a aresta do grafo que
  // levou o usuário a este título (registrado quando ele aceita o prompt da
  // watchlist). Null = descoberta não rastreada. SetNull em delete da aresta.
  origem_relacao_id String? @map("origem_relacao_id") @db.Uuid
  // Campos legados (era T2: 'assistiu'/'avaliou'/'recomendou_receber').
  // Mantidos para o export LGPD (lgpd.service lê a tabela). Nada novo
  // escreve neles a partir do Addendum 4.
  tipo        String?  @default("consumo") @db.VarChar(32)
  // Avaliação do usuário (1–5 estrelas, legado).
  rating      Int?
  // Comentário livre do usuário (legado). ATENÇÃO: plaintext —
  // ColumnEncryptionService existe mas não é usado (pendência T2.6).
  comentario  String?  @db.Text
  created_at  DateTime @default(now()) @map("created_at")
  // T289/T301: tenant_id (RLS em usuario_midia_interacao).
  tenant_id   String   @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid

  usuario     Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  midia       Midia    @relation(fields: [midia_id], references: [id], onDelete: Cascade)
  origem_relacao RelacaoObra? @relation("InteracaoOrigemRelacao", fields: [origem_relacao_id], references: [id], onDelete: SetNull)

  @@unique([usuario_id, midia_id])
  @@index([usuario_id])
  @@index([midia_id])
  @@index([origem_relacao_id])
  @@map("usuario_midia_interacao")
}

/// ADDENDUM 4 — Eixo 1: status de consumo (rótulo exibido conjuga por mídia).
enum StatusConsumo {
  QUERO_CONSUMIR
  CONSUMINDO
  CONCLUIDO
  ABANDONADO
}

/// ADDENDUM 4 — Eixo 2: reação (nunca obrigatória).
enum ReacaoConsumo {
  GOSTEI
  NAO_GOSTEI
}

/// ADDENDUM 4 — Motivo do abandono (opcional; só "NAO_CURTI" gera peso
/// negativo no motor de sinal — FALTA_TEMPO/MUDANCA_HUMOR nunca penalizam).
enum MotivoAbandono {
  NAO_CURTI
  FALTA_TEMPO
  MUDANCA_HUMOR
}

/// ADDENDUM 3 — grafo de obras relacionadas (1 aresta já ativa a
/// funcionalidade; não é container de grupo como Franquia/MidiaFranquia).
model RelacaoObra {
  id          String      @id @default(uuid()) @db.Uuid
  origem_id   String      @map("origem_id") @db.Uuid
  destino_id  String      @map("destino_id") @db.Uuid
  tipo        TipoRelacao
  /// Texto curto opcional ("Baseado no livro de 1965").
  nota_editorial String?  @map("nota_editorial") @db.VarChar(160)
  criado_em   DateTime    @default(now()) @map("criado_em")

  origem      Midia       @relation("RelacaoObraOrigem", fields: [origem_id], references: [id], onDelete: Cascade)
  destino     Midia       @relation("RelacaoObraDestino", fields: [destino_id], references: [id], onDelete: Cascade)
  // T201 (G4) — interações que chegaram a um título através desta aresta.
  interacoes_origem UsuarioMidiaInteracao[] @relation("InteracaoOrigemRelacao")

  @@unique([origem_id, destino_id])
  @@index([destino_id])
  @@index([origem_id])
  @@map("relacao_obra")
}

/// ADDENDUM 3/4 (T286) — evento de descoberta cross-mídia: gerado quando um
/// usuário reage GOSTEI a uma obra CONCLUÍDA que tem aresta no grafo
/// RelacaoObra; o feed "Descobertas" transforma o grafo em superfície.
/// UNIQUE (usuario_id, to_media_id) garante idempotência (nunca duplica).
model DiscoveryEvent {
  id            String      @id @default(uuid()) @db.Uuid
  usuario_id    String      @map("usuario_id") @db.Uuid
  from_media_id String      @map("from_media_id") @db.Uuid
  to_media_id   String      @map("to_media_id") @db.Uuid
  relation_type TipoRelacao
  created_em    DateTime    @default(now()) @map("created_em")
  tenant_id     String      @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid

  usuario       Usuario     @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  from_media    Midia       @relation("DiscoveryFrom", fields: [from_media_id], references: [id], onDelete: Cascade)
  to_media      Midia       @relation("DiscoveryTo", fields: [to_media_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, to_media_id])
  @@index([usuario_id, created_em])
  @@map("discovery_event")
}

/// T287 (Addendum 2) — origem editorial (mídia de origem da obra).
enum OrigemEditorial {
  FILME
  SERIE
  GAME
  LIVRO
  HQ
  MANGA
  ORIGINAL
}

/// T287 (Addendum 2) — classificação indicativa POR REGIÃO.
enum RegiaoClassificacao {
  BR
  US
  ES
}

/// T287 — classificação indicativa por região (BR/US/ES), valor livre da
/// certificação local + fonte (TMDB/IGDB). Unique (midia, regiao).
model ClassificacaoRegiao {
  midia_id String  @map("midia_id") @db.Uuid
  regiao   RegiaoClassificacao @map("regiao")
  valor    String  @db.VarChar(32)
  fonte    String  @db.VarChar(32)
  tenant_id String  @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid

  midia    Midia   @relation(fields: [midia_id], references: [id], onDelete: Cascade)

  @@id([midia_id, regiao])
  @@map("classificacao_regiao")
}

/// T287 (Addendum 2) — prêmios da obra (UML da Arquitetura: Award).
model Premio {
  id           String  @id @default(uuid()) @db.Uuid
  midia_id     String  @map("midia_id") @db.Uuid
  nome         String  @db.VarChar(160)
  categoria    String  @db.VarChar(160)
  ano          Int
  venceu       Boolean @default(true)
  organizacao  String  @db.VarChar(120)
  tenant_id    String  @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid

  midia        Midia   @relation(fields: [midia_id], references: [id], onDelete: Cascade)

  @@index([midia_id])
  @@map("premio")
}

/// T288 — temporada de série (TMDB). Unique (midia, numero).
model Temporada {
  id         String      @id @default(uuid()) @db.Uuid
  midia_id   String      @map("midia_id") @db.Uuid
  numero     Int
  titulo     String?     @db.Text
  ano        Int?
  poster_url String?     @map("poster_url")
  tenant_id  String      @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid

  midia      Midia       @relation(fields: [midia_id], references: [id], onDelete: Cascade)
  episodios  Episodio[]

  @@unique([midia_id, numero])
  @@index([midia_id])
  @@map("temporada")
}

/// T288 — episódio com notas (0-10 público; crítica nullable). Unique (temporada, numero).
model Episodio {
  id            String     @id @default(uuid()) @db.Uuid
  temporada_id  String     @map("temporada_id") @db.Uuid
  numero        Int
  titulo        String     @db.Text
  data_exibicao DateTime?  @map("data_exibicao")
  nota_publico  Float?     @map("nota_publico")
  nota_critica  Float?     @map("nota_critica")

  temporada     Temporada  @relation(fields: [temporada_id], references: [id], onDelete: Cascade)

  @@unique([temporada_id, numero])
  @@index([temporada_id])
  @@map("episodio")
}

/// T292 (Arquitetura §7) — feature flags leves em tabela (sem infra externa).
/// Avaliação server-side determinística; mudanças auditadas (admin only).
model FeatureFlag {
  key              String   @id @db.VarChar(64)
  enabled          Boolean  @default(true)
  rollout_percent  Int      @default(100)
  plan_gate        String?  @map("plan_gate") @db.VarChar(16)
  tenant_overrides Json?    @default("{}")
  updated_em       DateTime @updatedAt @map("updated_em")
  updated_by       String?  @map("updated_by") @db.Uuid

  @@map("feature_flags")
}

/// ADDENDUM 3 — tipo da aresta (direção: origem é sempre a que aponta).
enum TipoRelacao {
  ADAPTACAO_DE
  SEQUENCIA_DE
  PREQUELA_DE
  SPINOFF_DE
  MESMO_UNIVERSO
  MESMA_HISTORIA_REAL
}

/// Colunas do Kanban de Watchlist.
enum WatchlistColuna {
  WANT
  WATCHING
  COMPLETED
  DROPPED
}

/// Watchlist (lista para assistir depois). Dado pessoal LGPD.
model WatchlistEntry {
  id          String           @id @default(uuid()) @db.Uuid
  usuario_id  String           @map("usuario_id") @db.Uuid
  midia_id    String           @map("midia_id") @db.VarChar(255)
  coluna      WatchlistColuna  @default(WANT)
  prioridade  Int              @default(0)
  // T190: score da obra no momento da adição — permite o indicador
  // "score mudou" (↑/↓) sem fabricar dado. null = sem dado → sem seta.
  score_at_add Float?          @map("score_at_add")
  // T285 (Addendum 4): sinal de reação, motivo de abandono e progresso.
  // Reutiliza os enums do domínio de interação (ReacaoConsumo/MotivoAbandono)
  // para manter UM vocabulário (T285 nunca duplica enum — D-236).
  reacao             ReacaoConsumo?   @map("reacao")
  motivo_abandono    MotivoAbandono?  @map("motivo_abandono")
  progresso_detalhe  String?          @map("progresso_detalhe")
  // T289: multi-tenancy leve (default constante; RLS na T290).
  tenant_id          String           @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  created_at  DateTime         @default(now()) @map("created_at")
  updated_at  DateTime         @updatedAt @map("updated_at")

  usuario     Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, midia_id])
  @@index([usuario_id])
  @@map("watchlist_entry")
}

/// Preferências de gosto do usuário para recomendação.
/// Dado pessoal LGPD — armazenado em plaintext. A criptografia de coluna
/// (T2.6) NÃO está implementada em produção (pendência aberta).
model PreferenciaUsuario {
  usuario_id          String   @id @map("usuario_id") @db.Uuid
  // JSON com gêneros preferidos, atores favoritos, etc.
  // Plaintext (T2.6 pendente — ver DECISOES.md).
  preferencias_blob   String   @map("preferencias_blob") @db.Text
  // Versão do esquema de preferências (para migração futura).
  versao              Int      @default(1)
  updated_at          DateTime @updatedAt @map("updated_at")

  usuario             Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("preferencia_usuario")
}

/// Notificação in-app (D-132 — alertas "score mudou" na watchlist).
model Notificacao {
  id         String   @id @default(uuid()) @db.Uuid
  usuario_id String   @map("usuario_id") @db.Uuid
  tipo       String   @db.VarChar(32) // ex.: SCORE_MUDOU
  titulo     String   @db.VarChar(160)
  mensagem   String   @db.Text
  midia_id   String?  @map("midia_id") @db.VarChar(255)
  // JSON auxiliar (ex.: {"score": 82.4, "score_anterior": 71.0}).
  dados      Json?
  lida_at    DateTime? @map("lida_at")
  created_at DateTime @default(now()) @map("created_at")

  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id, lida_at])
  @@index([midia_id])
  @@map("notificacao")
}

/// Contador de uso diário por recurso (quotas de plano — D-132).
model UsoDiario {
  id         String   @id @default(uuid()) @db.Uuid
  usuario_id String   @map("usuario_id") @db.Uuid
  recurso    String   @db.VarChar(32) // ex.: 'recomendacoes'
  dia        String   @db.VarChar(10) // YYYY-MM-DD
  count      Int      @default(0)

  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, recurso, dia])
  @@index([usuario_id])
  @@map("uso_diario")
}

/// Lista colaborativa (Premium — D-132): qualquer usuário logado com o link
/// pode adicionar títulos; o dono edita/remove e é o único que pode excluir.
model ListaColaborativa {
  id        String      @id @default(uuid()) @db.Uuid
  dono_id   String      @map("dono_id") @db.Uuid
  titulo    String      @db.VarChar(160)
  descricao String?     @db.Text
  slug      String      @unique @db.VarChar(64)
  criada_at DateTime    @default(now()) @map("criada_at")

  dono      Usuario     @relation(fields: [dono_id], references: [id], onDelete: Cascade)
  itens     ListaItem[]

  @@index([dono_id])
  @@map("lista_colaborativa")
}

/// Item de uma lista colaborativa (join manual com midia — VarChar, sem FK).
model ListaItem {
  id             String            @id @default(uuid()) @db.Uuid
  lista_id       String            @map("lista_id") @db.Uuid
  midia_id       String            @map("midia_id") @db.VarChar(255)
  adicionado_por String?           @map("adicionado_por") @db.Uuid
  observacao     String?           @db.Text
  criado_at      DateTime          @default(now()) @map("criado_at")

  lista          ListaColaborativa @relation(fields: [lista_id], references: [id], onDelete: Cascade)
  adicionadoPor  Usuario?          @relation(fields: [adicionado_por], references: [id], onDelete: SetNull)

  @@unique([lista_id, midia_id])
  @@index([lista_id])
  @@map("lista_item")
}

/// Franquia/universo de mídia (Addendum 2 §7) — títulos de qualquer mídia.
model Franquia {
  id     String          @id @default(uuid()) @db.Uuid
  nome   String          @db.VarChar(120)
  slug   String          @unique @db.VarChar(64)
  midias MidiaFranquia[]

  @@map("franquia")
}

/// Vínculo N:N mídia ↔ franquia com ordens de lançamento e cronológica.
model MidiaFranquia {
  id               String   @id @default(uuid()) @db.Uuid
  midia_id         String   @map("midia_id") @db.Uuid
  franquia_id      String   @map("franquia_id") @db.Uuid
  // Ordem de lançamento real (sempre presente).
  ordem_lancamento Int      @map("ordem_lancamento")
  // Ordem dos eventos na história (null = sem divergência/desconhecida).
  ordem_cronologica Int?    @map("ordem_cronologica")

  midia            Midia    @relation(fields: [midia_id], references: [id], onDelete: Cascade)
  franquia         Franquia @relation(fields: [franquia_id], references: [id], onDelete: Cascade)

  @@unique([midia_id, franquia_id])
  @@index([franquia_id])
  @@map("midia_franquia")
}

/// Auditoria de visualizações do MEDIA Score (para métricas T1.9).
model MediaScoreView {
  id          String   @id @default(uuid()) @db.Uuid
  usuario_id  String?  @map("usuario_id") @db.Uuid
  midia_id    String   @map("midia_id") @db.Uuid
  score_exibido Float  @map("score_exibido")
  viewed_at   DateTime @default(now()) @map("viewed_at")

  usuario     Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  midia       Midia    @relation(fields: [midia_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([midia_id])
  @@index([viewed_at])
  @@map("media_score_view")
}

// ===========================================================================
// Domínio adicional — gêneros, streaming, auditoria (Fase 2 complemento)
// ===========================================================================

/// Gênero de mídia (ex: Drama, Ficção Científica, Ação).
/// ADDENDUM 2 Parte 4 + 3 Parte 3 — gênero normalizado com dualidade:
/// NARRATIVO (compartilhado cross-mídia: Ação, Drama, Terror...) ou
/// SUBGENERO (específico de mídia: RPG, Shonen... — restrito ao midia_alvo).
enum GeneroTipo {
  NARRATIVO
  SUBGENERO
}

model Genero {
  id      Int            @id @default(autoincrement())
  nome    String         @unique @db.VarChar(64)
  slug    String         @unique @db.VarChar(64)
  // ID do gênero na TMDB (vínculo do seed do catálogo).
  tmdb_id Int?           @unique @map("tmdb_id")
  tipo    GeneroTipo     @default(NARRATIVO)
  // Restrição de mídia para subgêneros (RPG → GAME, Shonen → ANIME, ...).
  midia_alvo TipoMidia?  @map("midia_alvo")
  midias  MidiaGenero[]

  @@index([tipo])
  @@map("genero")
}

/// N:N entre Midia e Genero.
model MidiaGenero {
  midia_id  String @map("midia_id") @db.Uuid
  genero_id Int    @map("genero_id")

  midia     Midia  @relation(fields: [midia_id], references: [id], onDelete: Cascade)
  genero    Genero @relation(fields: [genero_id], references: [id], onDelete: Cascade)

  @@id([midia_id, genero_id])
  @@map("midia_genero")
}

/// Serviço de streaming (ex: Netflix, Prime Video, Max, Crunchyroll).
model StreamingService {
  id   Int    @id @default(autoincrement())
  nome String @unique @db.VarChar(128)
  slug String @unique @db.VarChar(128)
  midias MidiaStreaming[]

  @@map("streaming_service")
}

/// N:N entre Midia e StreamingService.
model MidiaStreaming {
  midia_id    String @map("midia_id") @db.Uuid
  service_id  Int    @map("service_id")
  url         String? @db.Text

  midia       Midia  @relation(fields: [midia_id], references: [id], onDelete: Cascade)
  service     StreamingService @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@id([midia_id, service_id])
  @@map("midia_streaming")
}

/// Auditoria imutável (append-only) para conformidade LGPD e rastreabilidade.
/// hash_cadeia = SHA-256(hash_cadeia anterior + dados deste evento).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  entidade    String   @db.VarChar(64)
  entidade_id String   @db.VarChar(64)
  acao        String   @db.VarChar(32)
  usuario_id  String?  @map("usuario_id") @db.Uuid
  dados_antes Json?    @map("dados_antes")
  dados_depois Json?   @map("dados_depois")
  ip_origem   String?  @map("ip_origem") @db.Inet
  hash_cadeia String   @unique @map("hash_cadeia") @db.VarChar(64)
  hash_anterior String? @map("hash_anterior") @db.VarChar(64)
  created_at  DateTime @default(now()) @map("created_at")

  @@index([entidade, entidade_id])
  @@index([usuario_id])
  @@index([acao])
  @@index([created_at])
  @@map("audit_log")
}

/// Fatura de assinatura. Uma por período de cobrança.
model Fatura {
  id                String   @id @default(uuid()) @db.Uuid
  usuario_id        String   @map("usuario_id") @db.Uuid
  plano             Plano
  valor             Float
  moeda             String   @default("BRL") @db.VarChar(3)
  status            String   @default("pending") @db.VarChar(16)
  stripe_invoice_id String?  @unique @map("stripe_invoice_id") @db.VarChar(255)
  periodo_inicio    DateTime @map("periodo_inicio")
  periodo_fim       DateTime @map("periodo_fim")
  pago_em           DateTime? @map("pago_em")
  created_at        DateTime @default(now()) @map("created_at")

  usuario           Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([status])
  @@index([created_at])
  @@map("fatura")
}

/// Leads de categorias futuras (T185 — captura pública de e-mail).
model WaitlistNotify {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(254)
  category  String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, category])
  @@map("waitlist_notify")
}
