{
  "name": "@media-rate/api",
  "version": "0.1.0",
  "private": true,
  "description": "MEDIA Rate — backend NestJS.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node --import @swc-node/register/esm-register prisma/seed.ts",
    "db:seed:tmdb": "node --import @swc-node/register/esm-register prisma/seed-tmdb.ts",
    "db:seed:novas-midias": "node --import @swc-node/register/esm-register prisma/seed-novas-midias.ts",
    "db:seed:games": "node --import @swc-node/register/esm-register prisma/seed-games.ts",
    "db:seed:relacoes": "node --import @swc-node/register/esm-register prisma/seed-relacoes.ts",
    "db:seed:posters": "node --import @swc-node/register/esm-register prisma/seed-posters.ts",
    "db:audit:igdb": "node --import @swc-node/register/esm-register prisma/audit-igdb-ids.ts",
    "db:seed:metadata": "node --import @swc-node/register/esm-register prisma/seed-metadata.ts",
    "db:seed:slugs": "node --import @swc-node/register/esm-register prisma/seed-slug-backfill.ts",
    "db:seed:temporadas": "node --import @swc-node/register/esm-register prisma/seed-temporadas.ts",
    "db:provision:test-users": "node --import @swc-node/register/esm-register prisma/provision-test-users.ts",
    "db:reparo:watchlist": "node --import @swc-node/register/esm-register prisma/seed-reparo-watchlist.ts",
    "db:reparo:status-coluna": "node --import @swc-node/register/esm-register prisma/seed-reparo-status-coluna.ts",
    "db:reparo:orfaos": "node --import @swc-node/register/esm-register prisma/seed-reparo-orfaos.ts",
    "db:reset": "prisma migrate reset --force",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status"
  },
  "prisma": {
    "seed": "node --import @swc-node/register/esm-register prisma/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.70.0",
    "@swc/helpers": "^0.5.23",
    "argon2": "^0.41.1",
    "bullmq": "^5.81.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "posthog-node": "^5.45.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@swc-node/register": "^1.12.0",
    "@swc/core": "^1.15.43",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
