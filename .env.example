# ============================================================
# MEDIA Rate — MONOREPO — variáveis de tooling
# NÃO coloque segredos de produto aqui (Princípio do Menor Privilégio).
#   Backend:  apps/api/.env.example  ->  apps/api/.env
#   Frontend: apps/web/.env.example  ->  apps/web/.env.local
# ============================================================

# Ambiente padrão dos scripts locais.
NODE_ENV=development

# Porta usada pelos scripts locais (se aplicável).
PORT=4000

# Portas dos serviços locais (docker-compose). Mude se a porta já estiver em
# uso por outro projeto (ex.: outro Postgres na 5432 → use 5433).
POSTGRES_PORT=5432
REDIS_PORT=6379

# Apenas se usar Turborepo Remote Cache (TURBO_TOKEN + TURBO_TEAM).
# TURBO_TOKEN=
# TURBO_TEAM=
