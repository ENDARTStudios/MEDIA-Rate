# MEDIA Rate — variaveis de ambiente
#
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commitar .env (esta no .gitignore).
# NUNCA colar valores reais no chat com o Doer (Restricao #8 do PROTOCOLO_MESTRE.md).
# Use sempre o placeholder SUA_CHAVE_AQUI em exemplos e templates.

# ==========================================================================
# Ambiente (T0.7)
# ==========================================================================
NODE_ENV=development
# Valores validos: development | test | production

# Porta do backend NestJS (apps/api). Frontend Next.js usa porta 3000 por padrao.
PORT=4000

# ==========================================================================
# Banco de dados (T0.7) — PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ==========================================================================
DATABASE_URL=postgresql://USER:SUA_SENHA_AQUI@localhost:5432/media_rate?schema=public

# ==========================================================================
# Sessao e autenticacao (T0.7 — Fase 3)
# SESSION_SECRET: chave de assinatura de cookies. Gerar com:
#   openssl rand -base64 64
# Minimo 64 bytes de entropia.
# COOKIE_SECRET: idem, para criptografia de cookies se necessario.
# ==========================================================================
SESSION_SECRET=SUA_CHAVE_AQUI_GERE_COM_openssl_rand_base64_64
COOKIE_SECRET=SUA_CHAVE_AQUI_GERE_COM_openssl_rand_base64_64

# Hash de senha (Fase 2 / T2.5) — argon2id. Apenas em memoria, nao persistir.
# Deixe vazio para usar default do argon2 (recomendado).
ARGON2_SECRET_PEPPER=

# Criptografia de coluna (T2.6 — pgcrypto) — chave de aplicacao.
# Gerar com: openssl rand -base64 32
COLUMN_ENCRYPTION_KEY=SUA_CHAVE_AQUI_GERE_COM_openssl_rand_base64_32

# ==========================================================================
# CORS (T1.5 + T049/T056)
# ALLOWED_ORIGINS: lista canônica de origens permitidas (separadas por vírgula).
# CORS_ORIGIN: fallback/legado — lido SE ALLOWED_ORIGINS não estiver definido.
# NUNCA use '*' ou 'true' com credentials em produção.
# Em dev, localhost é permitido por default.
# ==========================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# CORS_ORIGIN=http://localhost:3000   (fallback, compatibilidade legada)

# ==========================================================================
# Logs (T1.8)
# Niveis: trace | debug | info | warn | error | fatal
# ==========================================================================
LOG_LEVEL=info

# ==========================================================================
# Rate limit (T1.3)
# Limite por janela de 60s. Por rota: login=6, api geral=100.
# ==========================================================================
RATE_LIMIT_LOGIN_PER_MIN=6
RATE_LIMIT_API_PER_MIN=100

# ==========================================================================
# Stripe — pagamento (T0.13 / T4.8)
# Pegar no painel: https://dashboard.stripe.com/apikeys
# Pegar webhook secret: https://dashboard.stripe.com/webhooks
# Price IDs: crie 3 produtos (Free, Plus, Premium) e copie os price_... de cada um.
# ==========================================================================
STRIPE_SECRET_KEY=SUA_CHAVE_AQUI
STRIPE_WEBHOOK_SECRET=SUA_CHAVE_AQUI
STRIPE_PUBLISHABLE_KEY=SUA_CHAVE_AQUI
STRIPE_PRICE_FREE_ID=SUA_CHAVE_AQUI
STRIPE_PRICE_PLUS_ID=SUA_CHAVE_AQUI
STRIPE_PRICE_PREMIUM_ID=SUA_CHAVE_AQUI

# Publishable key exposto no frontend Next.js (T5).
# Mesma chave do STRIPE_PUBLISHABLE_KEY acima, prefixada para o Next.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=SUA_CHAVE_AQUI

# ==========================================================================
# Analytics (T0.13 / T1.9) — PostHog Cloud free tier
# Pegar no painel: https://app.posthog.com/project/settings
# ==========================================================================
ANALYTICS_WRITE_KEY=SUA_CHAVE_AQUI
POSTHOG_HOST=https://app.posthog.com
# Proximo publico para o frontend Next.js:
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=SUA_CHAVE_AQUI
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ==========================================================================
# Fontes do MEDIA Score (T4.7) — chaves de API gratuitas
# OMDb: http://www.omdbapi.com/apikey.aspx
# TMDB: https://www.themoviedb.org/settings/api
# IGDB (Twitch): https://dev.twitch.tv/console/apps
# RAWG: https://rawg.io/apidocs
# Open Library: sem chave necessaria (open data)
# Goodreads: scraping publico dentro do robots.txt (sem chave)
# Metacritic: scraping publico dentro do robots.txt (sem chave)
# ==========================================================================
OMDB_API_KEY=SUA_CHAVE_AQUI
TMDB_API_KEY=SUA_CHAVE_AQUI
TWITCH_CLIENT_ID=SUA_CHAVE_AQUI
TWITCH_CLIENT_SECRET=SUA_CHAVE_AQUI
RAWG_API_KEY=SUA_CHAVE_AQUI

# ==========================================================================
# Fontes de Dados MEDIA Rate (Todas as Mídias) — especificação §I-§IX
# ---------------------------------------------------------------------------
# Chaves gratuitas (ativação P1):
#   OMDb (IMDb):             https://www.omdbapi.com/apikey.aspx
#   Trakt.tv (audiência):    https://trakt.tv/oauth/applications
#   OpenCritic (crítica):    https://rapidapi.com/opencritic-opencritic-default/api/opencritic-api
#   Comic Vine (HQs):        https://comicvine.gamespot.com/api/
#   Google Books (livros):   https://console.cloud.google.com/apis/library/books.googleapis.com
# Chave paga (mantém a fonte inativa sem ela):
#   Steam Spy:               https://steamspy.com/ (API pública descontinuada)
# IMDB_DATASET_PATH: diretório local dos datasets IMDb (coleta em lote).
# ==========================================================================
OMDB_API_KEY=SUA_CHAVE_AQUI
TRAKT_CLIENT_ID=SUA_CHAVE_AQUI
TRAKT_CLIENT_SECRET=SUA_CHAVE_AQUI
OPENCRITIC_API_KEY=SUA_CHAVE_AQUI
COMICVINE_API_KEY=SUA_CHAVE_AQUI
GOOGLE_BOOKS_API_KEY=SUA_CHAVE_AQUI
STEAMSPY_API_KEY=
IMDB_DATASET_PATH=

# Gates de ativação (desligados por padrão; ligue apenas quando quiser a fase):
# SCRAPE_NUMERICO_ENABLED=true  -> Letterboxd, RT, Metacritic, RogerEbert (scrape de nota numérica)
# MEDIA_PREPARACAO_ENABLED=true -> P2: goodreads/skoob/librarything/amazon/openlibrary/comicbookroundup/animeplanet
SCRAPE_NUMERICO_ENABLED=false
MEDIA_PREPARACAO_ENABLED=false

# URLs de Callback (para Trakt OAuth)
TRAKT_REDIRECT_URI=http://localhost:3000/api/auth/callback/trakt