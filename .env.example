# =============================================================================
# AMBIENTE E CONFIGURAÇÕES DA APLICAÇÃO
# =============================================================================
NODE_ENV=development
ADMIN_TOKEN=
COOKIE_SECRET=
JWT_SECRET=
REVALIDATE_SECRET=
WEB_REVALIDATE_URL=

# Redirecionamentos e CORS
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=

# =============================================================================
# BANCO DE DADOS E CACHE (REDIS)
# =============================================================================
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=file:./local.db

REDIS_URL=redis://localhost:6379

# =============================================================================
# PLATAFORMA (VERCEL & DEPLOYMENT)
