{
  "name": "media-rate",
  "version": "0.1.0",
  "private": true,
  "description": "MEDIA Rate — plataforma de descoberta de midia (filmes, series, games, livros) com MEDIA Score unificado. Copyright (c) 2026 END ART Studios. Todos os direitos reservados.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "security:gate": "node --import @swc-node/register/esm-register scripts/security-gate.ts",
    "audit:ci": "node scripts/audit-ci.mjs"
  },
  "config": {
    "auditAllowlist": [
      {
        "ghsa": "GHSA-ggr8-5vv4-36mx",
        "motivo": "P009/D-462: deepmerge-ts só via CLI prisma (dev-time, inputs do repo); fix exige Prisma major",
        "revisao": "2026-12"
      },
      {
        "ghsa": "GHSA-w2qp-rph6-63g4",
        "motivo": "D-559b: fastify <=5.12.4 — fix exige fastify 5.12.5+, mas @nestjs/platform-fastify 11.2.7/12.1.2 pinam 5.11.3/5.12.1 (exato). Upgrade Nest major 12.x na agenda; mitigação: helmet + proxy + sem exposição direta",
        "revisao": "2026-11"
      },
      {
        "ghsa": "GHSA-3m5p-2c4r-xxw2",
        "motivo": "D-559b: mesmo lote do GHSA-w2qp (fastify <=5.12.4) — ver entrada anterior",
        "revisao": "2026-11"
      },
      {
        "ghsa": "GHSA-4mh8-r7rc-xpvc",
        "motivo": "D-559b: mesmo lote do GHSA-w2qp (fastify <=5.12.4) — ver entrada anterior",
        "revisao": "2026-11"
      }
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "@swc/core@1.15.43": true,
    "argon2@0.41.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.33.5": true,
    "sharp@0.34.5": true,
    "sharp@0.35.4": true,
    "@parcel/watcher@2.5.6": true
  }
}
